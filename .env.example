# Supabase Postgres session pooler (app runtime)
DATABASE_URL=

# Supabase direct connection (used for migrations; ?options= for migration guards)
DIRECT_DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — omit to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — password reset / account deletion emails
RESEND_API_KEY=
EMAIL_FROM=SaaS Template <noreply@example.com>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# Site URL for Stripe portal return (optional, falls back to BETTER_AUTH_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (PWA notifications) — generate with: pnpm exec web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Comma-separated Better Auth user IDs allowed to access admin-only areas (optional)
ADMIN_USER_IDS=

# Optional Gemini key for /help chatbot (FAQ + support form work without it)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional public GitHub issues URL shown on the Help page
NEXT_PUBLIC_GITHUB_ISSUES_URL=

# E2E mock dashboard (Playwright only — do not set in real environments)
E2E_MOCK_DASHBOARD=false
