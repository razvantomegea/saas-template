{
  "name": "saas-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc --noEmit",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "prerelease": "pnpm format && pnpm lint:fix && pnpm test:coverage && pnpm test:e2e && pnpm build && pnpm fallow:audit && pnpm version:bump",
    "release:on-main": "node scripts/release-on-main.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/prepare-e2e-dev.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --quiet"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.58",
    "@ai-sdk/react": "4.0.88",
    "@tanstack/react-query": "5.101.0",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "7.0.85",
    "better-auth": "1.6.15",
    "drizzle-orm": "0.45.2",
    "next": "16.3.6",
    "postgres": "3.4.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "sonner": "2.0.7",
    "stripe": "22.2.0",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "16.6.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fallow": "2.89.0",
    "happy-dom": "^20.10.2",
    "prettier": "3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.15.1"
}
